upstream_repository=https://github.com/omacom/ttfx.git
upstream_tag=v0.3.2
upstream_commit=7203e354498462064b7c0a89375051f65cf2ce99
omacy_imported_at=2026-08-27
submodule_repository=https://github.com/theboringhumane/ttfx.git
submodule_branch=macarchy-native-bridge
submodule_commit=5e19b78b263e067492b07a044c789d63ece5176d

# ttfx is a Rust port pinned to this TerminalTextEffects release.
tte_repository=https://github.com/ChrisBuilds/terminaltexteffects.git
tte_tag=v0.15.0
tte_commit=7a91dd9ca6ee0c4f4b1484efee0ecac1bb84104e

# Only these upstream ttfx paths differ in the pinned native bridge commit.
# Individual effect implementations under src/effects/*.rs are forbidden.
# The fork already includes this patch; retained here for provenance.
local_patch=patches/ttfx-omacy.patch
allow=src/effects/mod.rs
allow=src/engine/ctx.rs
allow=src/engine/effect.rs
allow=src/engine/mod.rs
allow=src/engine/terminal.rs
allow=src/utils/ansi.rs
allow=src/utils/rng.rs
